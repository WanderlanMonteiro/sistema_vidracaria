# Copie para .env e preencha com as credenciais do banco MySQL criado no cPanel da HostGator.
# NUNCA commite o arquivo .env (já está no .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=usuariocpanel_esquadrias
DB_USER=usuariocpanel_dbuser
DB_PASS=troque-esta-senha
DB_CHARSET=utf8mb4

# 1 para exibir stack trace nas respostas de erro (nunca use 1 em produção).
APP_DEBUG=0
